DATABASE_URL="postgresql://USER:PASSWORD@RDS_INTERNAL_ENDPOINT:5432/manufacturing_oms?sslmode=disable"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@RDS_INTERNAL_ENDPOINT:5432/manufacturing_oms?sslmode=disable"
PORT=3001

# While testing by public IP, set this to http://YOUR_ECS_PUBLIC_IP.
# After ICP filing and domain setup, add https://your-domain.com too.
FRONTEND_ORIGIN="http://YOUR_ECS_PUBLIC_IP"

# Required. Use at least 32 random characters, for example: openssl rand -base64 48
JWT_SECRET="replace-with-at-least-32-random-characters"

# Required in production when the database has no users yet.
# Used only once by backend startup to initialize the first admin account.
DEFAULT_ADMIN_NAME="系统管理员"
DEFAULT_ADMIN_PHONE="admin-phone-or-login"
DEFAULT_ADMIN_PASSWORD="replace-with-a-strong-initial-password"
DEFAULT_ADMIN_DEPARTMENT="管理部"

ANTHROPIC_API_KEY=""
