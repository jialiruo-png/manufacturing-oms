# Manufacturing OMS environment template
# Production architecture: Aliyun ECS + Aliyun RDS PostgreSQL + Nginx + PM2.
# Copy this file to backend/.env on the server and replace every placeholder.
# Never commit real passwords, database URLs, JWT secrets, or API keys.

# ---------------------------------------------------------------------------
# Backend runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# Comma-separated origins allowed to call the API.
# Use the ECS public IP during trial, then add the official domain after DNS/HTTPS is ready.
FRONTEND_ORIGIN="http://YOUR_ECS_PUBLIC_IP,https://your-domain.com"

# Required. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-at-least-32-random-characters"

# ---------------------------------------------------------------------------
# Aliyun RDS PostgreSQL
# ---------------------------------------------------------------------------
# Use the RDS internal endpoint when backend and RDS are in the same VPC.
# Aliyun RDS PostgreSQL in the current deployment does not require SSL on the internal endpoint.
DATABASE_URL="postgresql://RDS_USER:RDS_PASSWORD@RDS_INTERNAL_ENDPOINT:5432/manufacturing_oms?sslmode=disable"
DATABASE_URL_UNPOOLED="postgresql://RDS_USER:RDS_PASSWORD@RDS_INTERNAL_ENDPOINT:5432/manufacturing_oms?sslmode=disable"

# ---------------------------------------------------------------------------
# Initial administrator
# ---------------------------------------------------------------------------
# Required only before the first official admin account exists.
# After delivery, manage users in the system Users page.
DEFAULT_ADMIN_NAME="系统管理员"
DEFAULT_ADMIN_PHONE="admin-phone-or-login"
DEFAULT_ADMIN_PASSWORD="change-me-before-production"
DEFAULT_ADMIN_DEPARTMENT="管理部"

# ---------------------------------------------------------------------------
# AI order/material parsing
# ---------------------------------------------------------------------------
# Optional but required for AI Excel parsing, AI image recognition, and AI material suggestions.
# Apply at: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=""

# Text/material parsing model. qwen-turbo is fast and cheap for structured extraction.
DASHSCOPE_MODEL=qwen-turbo

# Image order recognition model.
DASHSCOPE_VL_MODEL=qwen-vl-plus

# Legacy key kept only for compatibility with old deployments. Leave empty.
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Frontend build
# ---------------------------------------------------------------------------
# Leave empty when Nginx serves frontend and proxies /api on the same domain.
# For separated frontend/backend domains, set this to the full API base URL.
VITE_API_BASE_URL=""
