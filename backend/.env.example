# Backend environment template for Aliyun ECS.
# Copy to /var/www/manufacturing-oms-v5/backend/.env on the server.
# Do not commit the real backend/.env file.

NODE_ENV=production
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN="http://YOUR_ECS_PUBLIC_IP,https://your-domain.com"

# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-at-least-32-random-characters"

# Aliyun RDS PostgreSQL. Prefer the internal endpoint inside the same VPC.
DATABASE_URL="postgresql://RDS_USER:RDS_PASSWORD@RDS_INTERNAL_ENDPOINT:5432/manufacturing_oms?sslmode=disable"
DATABASE_URL_UNPOOLED="postgresql://RDS_USER:RDS_PASSWORD@RDS_INTERNAL_ENDPOINT:5432/manufacturing_oms?sslmode=disable"

# Required only before the first admin account exists.
DEFAULT_ADMIN_NAME="系统管理员"
DEFAULT_ADMIN_PHONE="admin-phone-or-login"
DEFAULT_ADMIN_PASSWORD="change-me-before-production"
DEFAULT_ADMIN_DEPARTMENT="管理部"

# Aliyun DashScope / Qwen. Required for AI Excel parsing, AI image parsing, and AI material suggestions.
# Apply at: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=""
DASHSCOPE_MODEL=qwen-turbo
DASHSCOPE_VL_MODEL=qwen-vl-plus

# Legacy compatibility. Leave empty unless an old parser explicitly needs it.
ANTHROPIC_API_KEY=""
